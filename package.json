{
  "name": "es-normalizer",
  "version": "2.6.0",
  "description": "Contact data normalization adapted from the Empreinte Sociométrique's normalizers",
  "main": "dist/lib/src/typescript/index.js",
  "types": "dist/lib/src/typescript/index.d.ts",
  "scripts": {
    "bundle": "esbuild lib/src/typescript/index.ts --bundle --sourcemap --platform=browser --format=iife --global-name=esNormalizer --outfile=dist/esNormalizer-${npm_package_version}.js",
    "minify": "esbuild lib/src/typescript/index.ts --bundle --minify --platform=browser --format=iife --global-name=esNormalizer --outfile=dist/esNormalizer-${npm_package_version}.min.js",
    "compile": "eslint lib/**/*.ts && tsc",
    "fix": "eslint lib/**/*.ts --fix",
    "test": "npm run test-node && npm run test-browser",
    "test-browser": "tsc && esbuild test/src/typescript/browser.spec.ts --bundle --outfile=dist/test/src/typescript/index.js --platform=browser --format=iife && live-server --port=10001 --mount=/:test/src/typescript",
    "test-node": "tsc && esbuild test/src/typescript/node.spec.ts --bundle --outfile=dist/test/node.spec.cjs --platform=node --format=cjs --external:mocha && mocha dist/test/node.spec.cjs",
    "test:ci": "tsc && esbuild test/src/typescript/node.spec.ts --bundle --outfile=dist/test/node.spec.cjs --platform=node --format=cjs --external:mocha && mocha dist/test/node.spec.cjs",
    "fix-test": "eslint test/**/*.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrildever/es-normalizer.git"
  },
  "keywords": [
    "data",
    "contact",
    "normalization",
    "empreinte sociometrique"
  ],
  "author": "Cyril Dever <cdever@pep-s.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cyrildever/es-normalizer/issues"
  },
  "homepage": "https://github.com/cyrildever/es-normalizer#readme",
  "dependencies": {
    "moment": "^2.31.0",
    "ts-utls": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-no-loops": "~0.4.0",
    "globals": "^17.13.0",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3"
  }
}